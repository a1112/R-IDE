+{
+  "name": "@r-ide/decompress-compat",
+  "version": "1.0.0",
+  "private": true,
+  "description": "CommonJS adapter for Theia's asynchronous archive extraction API",
+  "license": "MIT",
+  "main": "index.cjs",
+  "files": ["index.cjs"],
+  "engines": {
+    "node": ">=22"
+  },
+  "dependencies": {
+    "@xhmikosr/decompress": "11.1.4"
+  }
+}
diff --git a/vendor/decompress-compat/index.cjs b/vendor/decompress-compat/index.cjs
new file mode 100644
index 0000000..5b6ebd5
--- /dev/null
+++ b/vendor/decompress-compat/index.cjs
@@ -0,0 +1,8 @@
+'use strict';
+
+// Theia requires a callable CommonJS export; extraction is already asynchronous.
+// Dynamic import also works on Node 22 versions without require(ESM) support.
+module.exports = async (...args) => {
+    const { default: decompress } = await import('@xhmikosr/decompress');
+    return decompress(...args);
+};
