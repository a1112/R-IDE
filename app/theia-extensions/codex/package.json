{
  "private": true,
  "name": "theia-ide-codex-ext",
  "version": "1.72.100",
  "description": "R-IDE Codex integration shell",
  "dependencies": {
    "@theia/core": "1.73.0-next.2"
  },
  "devDependencies": {
    "rimraf": "^2.7.1",
    "typescript": "~5.9.3"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/ride-codex-frontend-module",
      "backend": "lib/node/ride-codex-backend-module"
    }
  ],
  "keywords": [
    "theia-extension"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eclipse-theia/theia-ide.git"
  },
  "bugs": {
    "url": "https://github.com/eclipse-theia/theia-ide/issues"
  },
  "homepage": "https://github.com/eclipse-theia/theia-ide",
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "clean": "rimraf lib *.tsbuildinfo",
    "build": "tsc -b",
    "test": "rimraf test/dist && tsc -p tsconfig.test.json && node --test test/dist/test/*.test.js",
    "lint": "eslint --ext js,jsx,ts,tsx src",
    "lint:fix": "eslint --ext js,jsx,ts,tsx src --fix"
  }
}
