!macro NSIS_HOOK_POSTINSTALL
  WriteRegStr SHCTX "Software\Classes\${RIDE_PROGID}" "" "R-IDE Code File"
  WriteRegStr SHCTX "Software\Classes\${RIDE_PROGID}\DefaultIcon" "" "$\"$INSTDIR\${MAINBINARYNAME}.exe$\",0"
  WriteRegStr SHCTX "Software\Classes\${RIDE_PROGID}\shell\open" "" "Open with R-IDE"
  WriteRegStr SHCTX "Software\Classes\${RIDE_PROGID}\shell\open\command" "" "$\"$INSTDIR\${MAINBINARYNAME}.exe$\" $\"%1$\""
  WriteRegStr SHCTX "Software\Classes\Applications\${MAINBINARYNAME}.exe\shell\open\command" "" "$\"$INSTDIR\${MAINBINARYNAME}.exe$\" $\"%1$\""
  WriteRegStr SHCTX "Software\R-IDE\Capabilities" "ApplicationName" "R-IDE"
  WriteRegStr SHCTX "Software\R-IDE\Capabilities" "ApplicationDescription" "R-IDE code editor"
  WriteRegStr SHCTX "Software\RegisteredApplications" "R-IDE" "Software\R-IDE\Capabilities"
  !insertmacro RIDE_REGISTER_EXTENSIONS
  System::Call "shell32::SHChangeNotify(i,i,i,i) (0x08000000, 0x1000, 0, 0)"
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  !insertmacro RIDE_UNREGISTER_EXTENSIONS
  DeleteRegValue SHCTX "Software\RegisteredApplications" "R-IDE"
  DeleteRegKey SHCTX "Software\R-IDE\Capabilities"
  DeleteRegKey /ifempty SHCTX "Software\R-IDE"
  DeleteRegKey SHCTX "Software\Classes\Applications\${MAINBINARYNAME}.exe"
  DeleteRegKey SHCTX "Software\Classes\${RIDE_PROGID}"
  System::Call "shell32::SHChangeNotify(i,i,i,i) (0x08000000, 0x1000, 0, 0)"
!macroend
