!define RIDE_PROGID "R-IDE.CodeFile"

!macro RIDE_REGISTER_EXTENSION EXT
  WriteRegStr SHCTX "Software\Classes\.${EXT}\OpenWithProgids" "${RIDE_PROGID}" ""
  WriteRegStr SHCTX "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".${EXT}" ""
  WriteRegStr SHCTX "Software\R-IDE\Capabilities\FileAssociations" ".${EXT}" "${RIDE_PROGID}"
!macroend

!macro RIDE_UNREGISTER_EXTENSION EXT
  DeleteRegValue SHCTX "Software\Classes\.${EXT}\OpenWithProgids" "${RIDE_PROGID}"
  DeleteRegValue SHCTX "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".${EXT}"
  DeleteRegValue SHCTX "Software\R-IDE\Capabilities\FileAssociations" ".${EXT}"
!macroend

