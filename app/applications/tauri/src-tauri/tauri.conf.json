{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "R-IDE",
  "version": "1.72.100",
  "identifier": "com.ride.ide",
  "build": {
    "beforeBuildCommand": "",
    "frontendDist": "../tauri-frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "R-IDE",
        "width": 1440,
        "height": 1024,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#202020",
        "backgroundThrottling": "suspend"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:3000; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/512x512.png"
    ],
    "fileAssociations": [
      {
        "ext": ["bash", "sh", "zsh"],
        "mimeType": "application/x-shellscript",
        "name": "Shell Script",
        "description": "Shell script source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["fish"],
        "mimeType": "application/x-fishscript",
        "name": "Fish Shell Script",
        "description": "Fish shell script source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["bat", "cmd"],
        "mimeType": "application/x-bat",
        "name": "Windows Command Script",
        "description": "Windows command script source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["ps1", "psm1"],
        "mimeType": "application/x-powershell",
        "name": "PowerShell Script",
        "description": "PowerShell script source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["c"],
        "mimeType": "text/x-csrc",
        "name": "C Source",
        "description": "C source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["h"],
        "mimeType": "text/x-chdr",
        "name": "C Header",
        "description": "C header file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["cc", "cpp", "cxx"],
        "mimeType": "text/x-c++src",
        "name": "C++ Source",
        "description": "C++ source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["hpp"],
        "mimeType": "text/x-c++hdr",
        "name": "C++ Header",
        "description": "C++ header file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["cs"],
        "mimeType": "text/x-csharp",
        "name": "C# Source",
        "description": "C# source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["go"],
        "mimeType": "text/x-go",
        "name": "Go Source",
        "description": "Go source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["java"],
        "mimeType": "text/x-java",
        "name": "Java Source",
        "description": "Java source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["kt", "kts"],
        "mimeType": "text/x-kotlin",
        "name": "Kotlin Source",
        "description": "Kotlin source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["rs"],
        "mimeType": "text/rust",
        "name": "Rust Source",
        "description": "Rust source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["py", "pyw"],
        "mimeType": "text/x-python",
        "name": "Python Source",
        "description": "Python source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["r"],
        "mimeType": "text/x-r-source",
        "name": "R Source",
        "description": "R source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["rmd"],
        "mimeType": "text/x-r-ide-r-markdown",
        "name": "R Markdown",
        "description": "R Markdown document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["qmd"],
        "mimeType": "text/x-r-ide-quarto",
        "name": "Quarto Markdown",
        "description": "Quarto Markdown document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["sql"],
        "mimeType": "application/sql",
        "name": "SQL Source",
        "description": "SQL source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["htm", "html"],
        "mimeType": "text/html",
        "name": "HTML Document",
        "description": "HTML source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["css"],
        "mimeType": "text/css",
        "name": "CSS Stylesheet",
        "description": "CSS stylesheet source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["scss"],
        "mimeType": "text/x-scss",
        "name": "SCSS Stylesheet",
        "description": "SCSS stylesheet source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["less"],
        "mimeType": "text/x-r-ide-less",
        "name": "Less Stylesheet",
        "description": "Less stylesheet source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["cjs", "js", "mjs"],
        "mimeType": "text/javascript",
        "name": "JavaScript Source",
        "description": "JavaScript source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["jsx"],
        "mimeType": "text/x-r-ide-jsx",
        "name": "JavaScript JSX Source",
        "description": "JavaScript JSX source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["cts", "mts", "ts"],
        "mimeType": "application/typescript",
        "name": "TypeScript Source",
        "description": "TypeScript source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["tsx"],
        "mimeType": "text/x-r-ide-typescript-jsx",
        "name": "TypeScript TSX Source",
        "description": "TypeScript TSX source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["svelte"],
        "mimeType": "text/x-r-ide-svelte",
        "name": "Svelte Component",
        "description": "Svelte component source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["vue"],
        "mimeType": "text/x-r-ide-vue",
        "name": "Vue Component",
        "description": "Vue component source file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["json"],
        "mimeType": "application/json",
        "name": "JSON Document",
        "description": "JSON configuration file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["jsonc"],
        "mimeType": "application/x-r-ide-jsonc",
        "name": "JSON with Comments",
        "description": "JSON with comments configuration file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["code-workspace", "theia-workspace"],
        "mimeType": "application/x-r-ide-workspace",
        "name": "IDE Workspace",
        "description": "IDE workspace configuration file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["xml"],
        "mimeType": "application/xml",
        "name": "XML Document",
        "description": "XML document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["yaml", "yml"],
        "mimeType": "application/yaml",
        "name": "YAML Document",
        "description": "YAML configuration file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["toml"],
        "mimeType": "application/toml",
        "name": "TOML Document",
        "description": "TOML configuration file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["ini"],
        "mimeType": "text/x-r-ide-ini",
        "name": "INI Document",
        "description": "INI configuration file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["properties"],
        "mimeType": "text/x-r-ide-properties",
        "name": "Properties Document",
        "description": "Properties configuration file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["markdown", "md"],
        "mimeType": "text/markdown",
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "publisher": "R-IDE contributors",
    "copyright": "Copyright © 2026 R-IDE contributors",
    "category": "Developer Tool",
    "shortDescription": "R-IDE Desktop Application",
    "longDescription": "R-IDE is a modern IDE built on Eclipse Theia, now packaged with Tauri for smaller footprint and better performance.",
    "macOS": {
      "minimumSystemVersion": "10.13",
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "resources": {
      "../browser-frontend": "lib/frontend",
      "../../../package.json": "package.json",
      "../resources/backend": "resources/backend",
      "../resources/plugins": "resources/plugins"
    }
  },
  "plugins": {}
}
