{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "R-IDE",
  "version": "1.72.100",
  "identifier": "com.ride.ide",
  "build": {
    "beforeBuildCommand": "",
    "frontendDist": "../tauri-frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "R-IDE",
        "width": 1440,
        "height": 1024,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 18,
          "y": 12
        },
        "hiddenTitle": true,
        "transparent": true,
        "shadow": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:3000; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/512x512.png"
    ],
    "publisher": "R-IDE contributors",
    "copyright": "Copyright © 2026 R-IDE contributors",
    "category": "Developer Tool",
    "shortDescription": "R-IDE Desktop Application",
    "longDescription": "R-IDE is a modern IDE built on Eclipse Theia, now packaged with Tauri for smaller footprint and better performance.",
    "macOS": {
      "minimumSystemVersion": "10.13",
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "resources": {
      "../browser-frontend": "lib/frontend",
      "../../../package.json": "package.json",
      "../resources/backend": "resources/backend",
      "../resources/plugins": "resources/plugins"
    }
  },
  "plugins": {}
}
