<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <!-- Extend system MIME types whose standard glob set omits approved editor extensions. -->
  <mime-type type="application/x-shellscript">
    <glob pattern="*.bash" weight="80"/>
    <glob pattern="*.zsh" weight="80"/>
  </mime-type>
  <mime-type type="application/x-bat">
    <glob pattern="*.bat" weight="80"/>
    <glob pattern="*.cmd" weight="80"/>
  </mime-type>
  <mime-type type="application/x-fishscript">
    <glob pattern="*.fish" weight="80"/>
  </mime-type>
  <mime-type type="application/x-powershell">
    <glob pattern="*.ps1" weight="80"/>
    <glob pattern="*.psm1" weight="80"/>
  </mime-type>
  <mime-type type="application/toml">
    <glob pattern="*.toml" weight="80"/>
  </mime-type>
  <mime-type type="application/yaml">
    <sub-class-of type="text/plain"/>
    <glob pattern="*.yaml" weight="80"/>
    <glob pattern="*.yml" weight="80"/>
  </mime-type>
  <mime-type type="text/x-kotlin">
    <glob pattern="*.kts" weight="80"/>
  </mime-type>
  <mime-type type="text/x-python">
    <glob pattern="*.pyw" weight="80"/>
  </mime-type>
  <mime-type type="text/javascript">
    <glob pattern="*.cjs" weight="80"/>
    <glob pattern="*.js" weight="80"/>
    <glob pattern="*.mjs" weight="80"/>
  </mime-type>
  <mime-type type="application/typescript">
    <comment>TypeScript source file</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.cts" weight="80"/>
    <glob pattern="*.mts" weight="80"/>
    <glob pattern="*.ts" weight="80"/>
  </mime-type>
  <mime-type type="text/x-r-source">
    <comment>R source file</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.r" weight="80"/>
  </mime-type>

  <!-- R-IDE-owned MIME types cover formats without a shared-mime-info mapping. -->
  <mime-type type="text/x-r-ide-r-markdown">
    <comment>R Markdown document</comment>
    <sub-class-of type="text/markdown"/>
    <glob pattern="*.rmd" weight="80"/>
  </mime-type>
  <mime-type type="text/x-r-ide-quarto">
    <comment>Quarto Markdown document</comment>
    <sub-class-of type="text/markdown"/>
    <glob pattern="*.qmd" weight="80"/>
  </mime-type>
  <mime-type type="text/x-r-ide-less">
    <comment>Less stylesheet source file</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.less" weight="80"/>
  </mime-type>
  <mime-type type="text/x-r-ide-jsx">
    <comment>JavaScript JSX source file</comment>
    <sub-class-of type="text/javascript"/>
    <glob pattern="*.jsx" weight="80"/>
  </mime-type>
  <mime-type type="text/x-r-ide-typescript-jsx">
    <comment>TypeScript TSX source file</comment>
    <sub-class-of type="application/typescript"/>
    <glob pattern="*.tsx" weight="80"/>
  </mime-type>
  <mime-type type="text/x-r-ide-svelte">
    <comment>Svelte component source file</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.svelte" weight="80"/>
  </mime-type>
  <mime-type type="text/x-r-ide-vue">
    <comment>Vue component source file</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.vue" weight="80"/>
  </mime-type>
  <mime-type type="application/x-r-ide-jsonc">
    <comment>JSON with comments configuration file</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.jsonc" weight="80"/>
  </mime-type>
  <mime-type type="application/x-r-ide-workspace">
    <comment>IDE workspace configuration file</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.code-workspace" weight="80"/>
    <glob pattern="*.theia-workspace" weight="80"/>
  </mime-type>
  <mime-type type="text/x-r-ide-ini">
    <comment>INI configuration file</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.ini" weight="80"/>
  </mime-type>
  <mime-type type="text/x-r-ide-properties">
    <comment>Properties configuration file</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.properties" weight="80"/>
  </mime-type>
</mime-info>
