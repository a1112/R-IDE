{
  "schema": "ride.tauri-frontend-profile@1",
  "profiles": {
    "tauri-critical": {
      "roots": [
        "@theia/core",
        "@theia/editor",
        "@theia/filesystem",
        "@theia/workspace",
        "@theia/monaco",
        "@theia/navigator",
